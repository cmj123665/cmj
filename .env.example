# 游戏大厅后端配置文件
# 复制此文件为 .env 并填入您的API密钥

# 服务器配置
PORT=3000
NODE_ENV=development

# 短信服务提供商选择 (aliyun, tencent, cloopen)
SMS_PROVIDER=aliyun

# ========== 阿里云短信服务配置 ==========
# 获取地址: https://dysms.console.aliyun.com/
ALIYUN_ACCESS_KEY_ID=你的AccessKeyId
ALIYUN_ACCESS_KEY_SECRET=你的AccessKeySecret
ALIYUN_SIGN_NAME=你的短信签名
ALIYUN_TEMPLATE_CODE=你的短信模板CODE

# ========== 腾讯云短信服务配置 ==========
# 获取地址: https://console.cloud.tencent.com/sms
TENCENT_SECRET_ID=你的SecretId
TENCENT_SECRET_KEY=你的SecretKey
TENCENT_SDK_APP_ID=你的SDKAppID
TENCENT_SIGN_NAME=你的短信签名
TENCENT_TEMPLATE_ID=你的模板ID

# ========== 容联云短信服务配置 ==========
# 获取地址: https://www.yuntongxun.com/
CLOOPEN_ACCOUNT_SID=你的AccountSid
CLOOPEN_ACCOUNT_TOKEN=你的AccountToken
CLOOPEN_APP_ID=你的AppID
CLOOPEN_TEMPLATE_ID=你的模板ID
